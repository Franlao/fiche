          "type": "array"
        }
      },
      "title": "Couverture",
      "type": "object"
    },
    "DecisionBloc": {
      "description": "Quand le cours distingue des cas : « si …, alors … ».",
      "properties": {
        "type": {
          "const": "decision",
          "title": "Type",
          "type": "string"
        },
        "titre": {
          "title": "Titre",
          "type": "string"
        },
