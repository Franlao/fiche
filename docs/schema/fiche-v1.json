      "required": [
        "type",
        "titre",
        "questions",
        "passages"
      ],
      "title": "AutotestBloc",
      "type": "object"
    },
    "BlocFiche": {
      "properties": {
        "bloc": {
          "discriminator": {
            "mapping": {
              "autotest": "#/$defs/AutotestBloc",
              "decision": "#/$defs/DecisionBloc",
              "definition": "#/$defs/DefinitionBloc",
              "encadre": "#/$defs/EncadreBloc",
              "essentiel": "#/$defs/EssentielBloc",
              "etapes": "#/$defs/EtapesBloc",
              "exemple": "#/$defs/ExempleBloc",
              "frise": "#/$defs/FriseBloc",
              "piege": "#/$defs/PiegeBloc",
              "tableau": "#/$defs/TableauBloc",
              "texte": "#/$defs/TexteBloc"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/TexteBloc"
            },
            {
              "$ref": "#/$defs/DefinitionBloc"
            },
            {
              "$ref": "#/$defs/EncadreBloc"
            },
            {
              "$ref": "#/$defs/TableauBloc"
            },
            {
              "$ref": "#/$defs/EtapesBloc"
            },
            {
              "$ref": "#/$defs/FriseBloc"
            },
            {
              "$ref": "#/$defs/DecisionBloc"
            },
            {
              "$ref": "#/$defs/ExempleBloc"
            },
            {
              "$ref": "#/$defs/PiegeBloc"
            },
            {
              "$ref": "#/$defs/EssentielBloc"
            },
            {
              "$ref": "#/$defs/AutotestBloc"
