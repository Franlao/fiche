    "EncadreBloc": {
      "description": "Ce qu'il faut savoir par cœur : théorème, propriété, formule, règle, loi, principe.",
      "properties": {
        "type": {
          "const": "encadre",
          "title": "Type",
          "type": "string"
        },
        "nature": {
          "enum": [
            "theoreme",
            "propriete",
            "formule",
            "regle",
            "loi",
            "principe"
          ],
