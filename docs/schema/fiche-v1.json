          "type": "string"
        },
        "titre": {
          "description": "Nom du résultat tel que le cours le nomme",
          "title": "Titre",
          "type": "string"
        },
        "enonce": {
          "description": "L'énoncé exact ; formules en LaTeX entre $ $",
          "title": "Enonce",
          "type": "string"
        },
        "conditions": {
          "description": "Hypothèses ou conditions de validité, ou liste vide",
          "items": {
            "type": "string"
          },
          "title": "Conditions",
          "type": "array"
        },
        "variables": {
          "description": "Sens de chaque symbole de la formule, ou vide",
          "items": {
            "$ref": "#/$defs/Variable"
          },
          "title": "Variables",
          "type": "array"
        },
        "idee": {
          "description": "Pourquoi c'est vrai, ou à quoi ça sert, si le cours le dit ; sinon vide",
          "title": "Idee",
          "type": "string"
        },
        "passages": {
          "description": "Numéros des extraits qui justifient le bloc, tels que donnés entre crochets",
          "items": {
            "type": "integer"
          },
          "title": "Passages",
          "type": "array"
        }
