      "required": [
        "type",
        "titre",
        "situation",
        "cas",
        "passages"
      ],
      "title": "DecisionBloc",
      "type": "object"
    },
    "DefinitionBloc": {
      "properties": {
        "type": {
          "const": "definition",
          "title": "Type",
          "type": "string"
        },
        "titre": {
          "description": "Le terme défini, avec la notation du cours",
          "title": "Titre",
          "type": "string"
