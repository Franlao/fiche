    "AutotestBloc": {
      "properties": {
        "type": {
          "const": "autotest",
          "title": "Type",
          "type": "string"
        },
        "titre": {
          "title": "Titre",
          "type": "string"
        },
        "questions": {
          "description": "2 à 4 questions",
          "items": {
            "$ref": "#/$defs/QuestionReponse"
          },
          "title": "Questions",
          "type": "array"
        },
        "passages": {
          "description": "Numéros des extraits qui justifient le bloc, tels que donnés entre crochets",
